# ==============================================================================
# Cooperative Fund Management System - Production Environment Variables
# ==============================================================================

# Application Environment
NODE_ENV=production
WEB_PORT=80
API_BASE_URL=/api/v1

# PostgreSQL Database Configuration
POSTGRES_DB=coop_fund_db
POSTGRES_USER=coop_admin
POSTGRES_PASSWORD=ChangeThisToStrongPassword2026!
DB_HOST=coop_postgres_db
DB_PORT=5432

# Redis Cache & Session Store
REDIS_HOST=coop_redis_cache
REDIS_PORT=6379
REDIS_PASSWORD=ChangeThisRedisPass2026!

# JWT Authentication & Session Secrets
JWT_SECRET=super_secret_jwt_signing_key_at_least_32_characters_long_2026
SESSION_TIMEOUT_MINUTES=15
SESSION_MAX_LIFETIME_HOURS=8

# Field-Level Sensitive Data Encryption (AES-256-GCM)
ENCRYPTION_MASTER_KEY=coop_aes256_master_key_for_bvn_and_accounts_2026

# Two-Factor Authentication (TOTP 2FA)
TOTP_ISSUER=FederalMinistryCooperativeFund

# Transactional Email (SMTP / SendGrid / AWS SES)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_api_key
SMTP_FROM_EMAIL=notifications@coopfund.gov.ng
SMTP_FROM_NAME="Ministry Cooperative Fund"

# SMS Gateway (Termii / Twilio / Africa's Talking)
SMS_PROVIDER=termii
TERMII_API_KEY=your_termii_api_key
TERMII_SENDER_ID=COOPFUND

# Backup & Disaster Recovery Storage
BACKUP_S3_BUCKET=govcloud-coop-fund-backups
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
